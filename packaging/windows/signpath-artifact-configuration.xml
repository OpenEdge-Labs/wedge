<!--
  SignPath artifact configuration for the Windows release files. The release
  workflow uploads one artifact (a zip) holding the MSI and the portable zip;
  SignPath signs wedge.exe inside each, then the MSI itself. Paste this into
  the project's artifact configuration on signpath.io (slug "release").
  See docs/security/code-signing.md.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <msi-file path="wedge-*-x86_64.msi">
      <pe-file path="wedge.exe">
        <authenticode-sign />
      </pe-file>
      <authenticode-sign />
    </msi-file>
    <zip-file path="wedge-*-x86_64-pc-windows-msvc.zip">
      <pe-file path="wedge.exe">
        <authenticode-sign />
      </pe-file>
    </zip-file>
  </zip-file>
</artifact-configuration>
